# ============================================================
# AW Property Management — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# --- Supabase ---
# Find these in your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Resend (Email) ---
# Create an account at resend.com, verify your domain, get API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Email address that notifications are sent FROM (must be verified in Resend)
RESEND_FROM_EMAIL=notifications@yourdomain.com
# Where to send owner/manager notifications (comma-separated)
NOTIFY_EMAIL=owner@yourdomain.com

# --- Twilio (SMS) ---
# Create an account at twilio.com, buy a phone number
# Find Account SID and Auth Token in the Twilio Console dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
# Your Twilio phone number (E.164 format, e.g. +12025551234)
TWILIO_PHONE_NUMBER=+12025551234

# --- Admin gating (siloed/admin-only features, e.g. UniFi integration) ---
# Comma-separated emails allowed to access /admin/* during testing.
ADMIN_EMAILS=you@example.com

# --- UniFi (Ubiquiti) integration ---
# Leave these unset to run the integration in DRY-RUN mode (no live controller).
# The console must be reachable from the app: port-forward 443 (Network/Protect)
# and 12445 (Access) to the console. Raw WAN IP works; TLS verification is auto-
# skipped for raw IPs (or set UNIFI_INSECURE_TLS=true).
UNIFI_CONSOLE_URL=https://67.253.65.134
# ONE Integrations key (Control Plane -> Integrations). Covers Network + Protect and
# is reused as the Access (:12445) token unless UNIFI_ACCESS_API_TOKEN is set.
UNIFI_API_KEY=your-console-integration-api-key
# Only set if your console issues a distinct UniFi Access token:
UNIFI_ACCESS_API_TOKEN=
# Optional; defaults to <console host>:12445
UNIFI_ACCESS_API_URL=
# Optional Network site UUID; auto-resolved from GET /sites when blank:
UNIFI_SITE_ID=
# Skip TLS verification (auto-on for raw IPs):
UNIFI_INSECURE_TLS=
# Set to "true" to force simulation even when the above are present.
UNIFI_DRY_RUN=
